pipeline {
    agent any

    stages {
        stage('Create directories') {
            steps {
                dir("${WORKSPACE}/jenkins/uperdata/scritps") {
                    sh 'chmod +x create_directories_hdfs.sh'
                    sh './create_directories_hdfs.sh'
                }
            }
        }

        stage('Import data-set') {
            steps {
                dir("${WORKSPACE}") {
                    sh 'chmod +x jenkins/uperdata/scritps/update_dataset_hdfs.sh'
                    sh 'bash jenkins/uperdata/scritps/update_dataset_hdfs.sh'
                }
            }
        }
    }
}