pipeline {
    agent any

    stages {
        stage('Create directories') {
            steps {
                dir('/jenkins/uperdata/scritps') {
                    sh 'chmod +x create_directories_hdfs.sh'
                    sh './create_directories_hdfs.sh'
                }
            }
        }
        stage('Import data-set'){
            steps{
                dir('/tmp/dataset'){
                    sh 'chmod +x update_dataset_hdfs.sh'
                    sh './update_dataset_hdfs.sh'
                }
            }
        }
    }
}